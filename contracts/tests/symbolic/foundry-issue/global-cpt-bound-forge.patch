+        predicate: &SymBoolExpr,
+        zero_operand: Option<&SymExpr>,
+    ) -> Option<(SymExpr, SymExpr)> {
+        let SymBoolExprKind::Cmp(SymCmpOp::Eq, left, right) = predicate.kind() else {
+            return None;
+        };
