{
  "name": "origin-defi-contracts",
  "version": "0.1.0",
  "description": "Origin DeFi Contracts",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "check:storage": "node scripts/check-storage-layout.js",
    "test:scripts": "node --test scripts/test/check-storage-upgrade.test.js scripts/test/export-abi.test.js scripts/test/storage-upgrade.test.js",
    "test:layouts": "node --test scripts/test/layout-pinned.test.js",
    "test:tasks": "TS_NODE_TRANSPILE_ONLY=true mocha --require ts-node/register \"tasks/test/**/*.js\"",
    "abi:generate": "rm -rf dist && forge clean && forge build contracts/ -j 1",
    "abi:dist": "node scripts/export-abi.js",
    "node": "pnpm run node:fork",
    "node:fork": "./node.sh fork",
    "node:arb": "FORK_NETWORK_NAME=arbitrumOne pnpm run node:fork",
    "node:base": "FORK_NETWORK_NAME=base pnpm run node:fork",
    "node:sonic": "FORK_NETWORK_NAME=sonic pnpm run node:fork",
    "node:plume": "FORK_NETWORK_NAME=plume pnpm run node:fork",
    "node:hoodi": "FORK_NETWORK_NAME=hoodi pnpm run node:fork",
    "node:hyperevm": "FORK_NETWORK_NAME=hyperevm pnpm run node:fork",
    "node:anvil": "anvil --fork-url $PROVIDER_URL --port 8545 --block-base-fee-per-gas 0 --auto-impersonate --disable-block-gas-limit",
    "node:anvil:base": "anvil --fork-url $BASE_PROVIDER_URL --port 8545 --block-base-fee-per-gas 0 --auto-impersonate --disable-block-gas-limit",
    "node:anvil:plume": "anvil --fork-url $PLUME_PROVIDER_URL --port 8545 --block-base-fee-per-gas 0 --auto-impersonate --disable-block-gas-limit",
    "node:anvil:sonic": "anvil --fork-url $SONIC_PROVIDER_URL --port 8545 --block-base-fee-per-gas 0 --auto-impersonate --disable-block-gas-limit",
    "node:anvil:hoodi": "anvil --fork-url $HOODI_PROVIDER_URL --port 8545 --block-base-fee-per-gas 0 --auto-impersonate --disable-block-gas-limit",
    "node:anvil:hyperevm": "anvil --fork-url $HYPEREVM_PROVIDER_URL --port 8545 --block-base-fee-per-gas 0 --auto-impersonate --disable-block-gas-limit",
    "lint": "pnpm run lint:js && pnpm run lint:ts && pnpm run lint:sol",
    "lint:js": "eslint \"tasks/**/*.js\" \"scripts/export-abi.js\" \"scripts/lib/**/*.js\" \"scripts/test/**/*.js\" \"utils/hardhat-task-helpers.js\"",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "lint:ts": "eslint \"tasks/actions/**/*.ts\" \"tasks/lib/**/*.ts\"",
    "prettier": "pnpm run prettier:js && pnpm run prettier:sol",
    "prettier:check": "prettier -c \"*.js\" \"scripts/**/*.js\" \"tasks/**/*.js\" \"utils/**/*.js\"",
    "prettier:js": "prettier --write \"*.js\" \"scripts/**/*.js\" \"tasks/**/*.js\" \"utils/**/*.js\"",
    "prettier:sol": "prettier --write --plugin=prettier-plugin-solidity \"contracts/**/*.sol\"",
    "prettier:ts": "prettier --write \"tasks/actions/**/*.ts\" \"tasks/lib/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "slither": "pnpm run clean && slither . --config-file slither.config.json",
    "slither:triage": "pnpm run clean && slither . --triage --config-file slither.config.json",
    "clean": "rm -rf build crytic-export artifacts cache deployments/local*",
    "action": "tsx tasks/run.ts",
    "dump-catalog": "tsx dump-actions-catalog.ts"
  },
  "author": "Origin Protocol Inc <support@originprotocol.com>",
  "license": "MIT",
  "devDependencies": {
    "@chainsafe/persistent-merkle-tree": "^1.2.1",
    "@lastdotnet/purrikey": "^1.0.0",
    "@openzeppelin/contracts": "4.4.2",
    "@openzeppelin/upgrades-core": "1.44.2",
    "@types/node": "25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "axios": "1.4.0",
    "chai": "4.3.7",
    "debug": "4.3.4",
    "dotenv": "10.0.0",
    "eslint": "8.57.1",
    "eslint-plugin-no-only-tests": "3.3.0",
    "ethers": "5.7.2",
    "hardhat": "2.26.2",
    "hardhat-deploy": "0.11.30",
    "hardhat-deploy-ethers": "0.3.0-beta.13",
    "mocha": "10.2.0",
    "prettier": "2.8.8",
    "prettier-plugin-solidity": "1.0.0-beta.17",
    "solhint": "3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "viem": "^2.27.0"
  },
  "dependencies": {
    "@chainlink/contracts-ccip": "1.2.1",
    "@chainsafe/bls": "^8.2.0",
    "@lodestar/api": "^1.44.0",
    "@lodestar/config": "^1.44.0",
    "@lodestar/params": "^1.44.0",
    "@lodestar/state-transition": "^1.44.0",
    "@lodestar/types": "^1.44.0",
    "@lodestar/utils": "^1.44.0",
    "@safe-global/api-kit": "^5.0.1",
    "@safe-global/protocol-kit": "^8.0.3",
    "@safe-global/types-kit": "^4.0.1",
    "origin-morpho-utils": "^0.1.1",
    "tsx": "^4.23.1"
  },
  "peerDependencies": {
    "@oplabs/talos-client": "0.0.28"
  },
  "peerDependenciesMeta": {
    "@oplabs/talos-client": {
      "optional": true
    }
  }
}
